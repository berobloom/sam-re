program T4;
{$S-}
type Rec = array[0..15] of Byte; Big = array[0..41] of Byte;
var f: file of Rec; g: file; t: Text; r: Rec; s, s2: string; i, code: Integer;
    p: Pointer; w: Word; l: LongInt; c: Char; b: Boolean; bg: Big;
procedure ValPar(x: Big); begin i := x[1] end;
begin
Assign(f, 'A.DAT');
Reset(f);
Rewrite(f);
Read(f, r);
Write(f, r);
Seek(f, 1);
Close(f);
Erase(f);
Assign(g, 'B.DAT');
Reset(g, 1);
BlockRead(g, r, 16, w);
BlockWrite(g, r, 16);
Assign(t, 'C.TXT');
Rewrite(t);
Reset(t);
Writeln(t);
Write(t, s);
Write(t, i);
Write(t, c);
Readln(t);
Read(t, s);
Read(t, i);
Close(t);
GetMem(p, 100);
FreeMem(p, 100);
New(p);
Dispose(p);
w := MaxAvail;
l := MemAvail;
s := 'abc';
s := s + s2;
s2 := Copy(s, 2, 3);
i := Pos('b', s);
Delete(s, 1, 1);
Insert('x', s, 1);
b := s = s2;
b := s < s2;
s := c;
c := UpCase(c);
Str(i, s);
Str(l, s);
Val(s, i, code);
Val(s, l, code);
i := Random(10);
Randomize;
l := l * i;
l := l div i;
l := l mod i;
Move(r, r[1], 3);
FillChar(r, 16, 0);
i := IOResult;
b := c in ['a'..'z', '0', '_'];
ValPar(bg);
i := Length(s);
Halt(1);
Halt;
RunError(5);
end.
