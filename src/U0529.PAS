function OnScreen(Margin, N: Integer): Boolean;
begin
  if Slots[N].X < CamX - Margin then
    OnScreen := False
  else if Slots[N].X > CamX + $140 + Margin then
    OnScreen := False
  else if Slots[N].Y < CamY - Margin then
    OnScreen := False
  else if Slots[N].Y > CamY + $B8 + Margin then
    OnScreen := False
  else
    OnScreen := True;
end;
