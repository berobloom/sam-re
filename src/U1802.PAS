{ src: SAM1RE 1802:0000 (../SAM: the page flip: W6864 page 0/1, W6866 its y offset 16 or 416) }
{ interface }
{ keep: FlipPage; }
procedure FlipPage;
begin
  if W6864 = 0 then
  begin
    W6864 := 1;
    W6866 := $1A0;
  end
  else
  begin
    W6864 := 0;
    W6866 := $10;
  end;
end;
{ src: SAM1RE 1802:0027 (shows the page: view start at CamX, W6866 + CamY) }
{ interface }
{ keep: ShowPage; }
procedure ShowPage;
begin
  if W70EC = 0 then
    SetViewStart(CamX, W6866 + CamY)
  else
    SetViewStartAlt(CamX, W6866 + CamY);
  W6862 := W6866;
end;
{ src: SAM1RE 1802:005F (palette registers 0..7 -> 0..7, 8..15 -> $10..$17, Delay(D) after each) }
{ interface }
{ keep: FadeIn(0); }
procedure FadeIn(D: Integer);
begin
  SetPalReg(0, 0);
  Delay(D);
  SetPalReg(1, 1);
  Delay(D);
  SetPalReg(2, 2);
  Delay(D);
  SetPalReg(3, 3);
  Delay(D);
  SetPalReg(4, 4);
  Delay(D);
  SetPalReg(5, 5);
  Delay(D);
  SetPalReg(6, 6);
  Delay(D);
  SetPalReg(7, 7);
  Delay(D);
  SetPalReg(8, $10);
  Delay(D);
  SetPalReg(9, $11);
  Delay(D);
  SetPalReg(10, $12);
  Delay(D);
  SetPalReg(11, $13);
  Delay(D);
  SetPalReg(12, $14);
  Delay(D);
  SetPalReg(13, $15);
  Delay(D);
  SetPalReg(14, $16);
  Delay(D);
  SetPalReg(15, $17);
  Delay(D);
end;
{ src: SAM1RE 1802:01B6 (palette registers 0..15 to black, Delay(D) before each) }
{ interface }
{ keep: FadeOut(0); }
procedure FadeOut(D: Integer);
var
  I: Integer;
begin
  for I := 0 to 15 do
  begin
    Delay(D);
    SetPalReg(I, 0);
  end;
end;
