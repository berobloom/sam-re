{ src: SAM1RE 1802:33D0 (../SAM menus: the sam1.apo logo with sound $15, then a key or about 5 s on the
  W6852 tick counter). Only R of the four locals is used. }
{ from: 33C7 }
{ to: 3477 }
{ interface }
{ keep: ShowLogo; }
procedure ShowLogo;
var
  V1, V2, R, V4: Integer;
begin
  FadeOut(0);
  R := Genus000F(2);
  R := Genus0047(1);
  R := SetStride($28);
  CamX := 0;
  CamY := 0;
  W6862 := 0;
  W6866 := 0;
  R := ShowPicture('sam1.apo', 1, 0, 0);
  FadeIn($14);
  PlaySound($15);
  MemW[0:$41C] := MemW[0:$41A];
  W6852 := 0;
  repeat
  until KeyPressed or (W6852 > $2D0);
  W6852 := 0;
  FadeOut(0);
end;
{ src: SAM1RE 1802:3489 (../SAM menus: the title: sam1.crd and sam1.ttl, the view scrolls down and up between
  them; W684A set (by the key handler) opens the menu; ends on B, R or Q with sound 12) }
{ from: 3477 }
{ to: 3694 }
{ interface }
{ keep: TitleLoop; }
procedure TitleLoop;
var
  Dir, Y, R: Integer;
  Key: Char;
begin
  FadeOut(0);
  R := Genus000F(2);
  R := Genus0047(1);
  R := SetStride($28);
  CamX := 0;
  CamY := 0;
  W6862 := 0;
  W6866 := 0;
  R := ShowPicture('sam1.crd', 1, 0, 0);
  Proc2ECF(0, 0, 0, 200);
  R := ShowPicture('sam1.ttl', 1, 0, 0);
  FadeIn($14);
  Dir := 1;
  Y := 0;
  W684A := 0;
  Key := ' ';
  W6852 := 0;
  repeat
    if W684A > 0 then
    begin
      Key := MainMenu;
      W684A := 0;
    end
    else
      W684A := 0;
  until (W6852 > $90) or (Key <> ' ');
  if (Key <> 'B') and (Key <> 'R') and (Key <> 'Q') then
  repeat
    if (Key <> 'B') and (Key <> 'R') and (Key <> 'Q') then
      Key := ' ';
    if Dir = 1 then
    begin
      if W70EC = 0 then
        SetViewStart(0, Y)
      else
        SetViewStartAlt(0, Y);
      W6862 := Y;
    end
    else
    begin
      if W70EC = 0 then
        SetViewStart(0, 200 - Y)
      else
        SetViewStartAlt(0, 200 - Y);
      W6862 := 200 - Y;
    end;
    Inc(Y);
    if Y > 200 then
    begin
      Y := 0;
      Dir := -Dir;
      W6852 := 0;
      repeat
        if W684A > 0 then
        begin
          Key := MainMenu;
          W684A := 0;
          W6852 := 0;
        end;
      until (W6852 > $1B0) or (Key <> ' ');
    end;
    B6EE9 := 0;
    B6EEA := 0;
    B6EF0 := 0;
    B6EF1 := 0;
    B6EEB := 0;
    MemW[0:$41C] := MemW[0:$41A];
    if W684A <> 0 then
    begin
      Key := MainMenu;
      W6852 := 0;
      W684A := 0;
    end;
  until (Key = 'B') or (Key = 'R') or (Key = 'Q');
  PlaySound(12);
  FadeOut(0);
end;
{ src: GUESS 1802:3696 (high-score check: if Score beats entry 10, ask the name, shift the table down,
  store name (padded to 22) + Str(Score:7) and show the table. P stays unset when no entry is lower,
  which cannot happen once Score > HiScore[10]) }
{ from: 3694 }
{ to: 381C }
{$F+}
procedure CheckHighScore;
var
  I, P: Integer;
  S: String;
begin
  if Score > HiScore[10] then
  begin
    HighScoreEntry;
    for I := 10 downto 1 do
      if HiScore[I] < Score then
        P := I;
    if P < 10 then
      for I := 10 downto P + 1 do
      begin
        HiScore[I] := HiScore[I - 1];
        HiName[I] := HiName[I - 1];
      end;
    for I := Length(NameInput) to 22 do
      NameInput := NameInput + ' ';
    Str(Score:7, S);
    NameInput := NameInput + S;
    HiScore[P] := Score;
    HiName[P] := NameInput;
    HallOfFame;
  end;
end;
{$F-}
