begin
  SetPalReg(0, 0);
  Delay(D);
  SetPalReg(1, 1);
  Delay(D);
  SetPalReg(2, 2);
  Delay(D);
  SetPalReg(3, 3);
  Delay(D);
  SetPalReg(4, 4);
  Delay(D);
  SetPalReg(5, 5);
  Delay(D);
  SetPalReg(6, 6);
  Delay(D);
  SetPalReg(7, 7);
  Delay(D);
  SetPalReg(8, $10);
  Delay(D);
  SetPalReg(9, $11);
  Delay(D);
  SetPalReg(10, $12);
  Delay(D);
  SetPalReg(11, $13);
  Delay(D);
  SetPalReg(12, $14);
  Delay(D);
  SetPalReg(13, $15);
  Delay(D);
  SetPalReg(14, $16);
  Delay(D);
  SetPalReg(15, $17);
  Delay(D);
end;
{ src: SAM1RE 1802:01B6 (palette registers 0..15 to black, Delay(D) before each) }
{ interface }
{ keep: FadeOut(0); }
procedure FadeOut(D: Integer);
var
  I: Integer;
begin
  for I := 0 to 15 do
  begin
    Delay(D);
    SetPalReg(I, 0);
  end;
end;
