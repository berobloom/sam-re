  WinKey: Integer; { @683A; scan code TextWindow returns (SAM1RE text-windows.md) }
  MenuReq: Byte; { @683C; menu/pause request (SAM1RE input.md) }
  Landings: Integer; { @683E; counts the player's landings (0529:66B3), GUESS }
